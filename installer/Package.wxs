<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Per-user MSI: installs to %LOCALAPPDATA%\Programs\urPDF, writes only to HKCU, needs no administrator rights.

    UpgradeCode identifies the product across versions. NEVER change it, or updates will install next to the old version.
    The ProductCode is generated for each build (Id="*"), which is what MajorUpgrade expects.
  -->
  <Package Name="urPDF"
           Manufacturer="adamj"
           Version="$(ProductVersion)"
           UpgradeCode="D144FE5F-8F20-4953-B5B4-C1029EF3AFB8"
           Scope="perUser"
           Language="1033"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of urPDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="urPDF" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- All files staged by scripts/stage-msi-payload.ps1 (Windows App SDK, C++ runtime, MuPDF dependencies). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**" />
    </ComponentGroup>

    <!-- Start menu shortcut. The HKCU value is the component key path required for per-user shortcuts. -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="UrPdfShortcut"
                Name="urPDF"
                Description="Simple PDF viewer"
                Target="[INSTALLFOLDER]urPDF.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\urPDF\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      PDF handling: urPDF shows up in "Open with" and in Settings > Default apps.
      It does not make itself the default PDF app; the user chooses that.
    -->
    <Component Id="PdfRegistration" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Classes\urPDF.Document">
        <RegistryValue Type="string" Value="PDF document" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="[INSTALLFOLDER]Assets\PdfFileIcon.ico" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]urPDF.exe&quot; &quot;%1&quot;" />
      </RegistryKey>

      <RegistryValue Root="HKCU" Key="Software\Classes\.pdf\OpenWithProgids" Name="urPDF.Document" Type="string" Value="" />

      <RegistryKey Root="HKCU" Key="Software\Classes\Applications\urPDF.exe">
        <RegistryValue Name="FriendlyAppName" Type="string" Value="urPDF" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]urPDF.exe&quot; &quot;%1&quot;" />
        <RegistryValue Key="SupportedTypes" Name=".pdf" Type="string" Value="" />
      </RegistryKey>

      <RegistryKey Root="HKCU" Key="Software\urPDF\Capabilities">
        <RegistryValue Name="ApplicationName" Type="string" Value="urPDF" />
        <RegistryValue Name="ApplicationDescription" Type="string" Value="Simple PDF viewer" />
        <RegistryValue Key="FileAssociations" Name=".pdf" Type="string" Value="urPDF.Document" />
      </RegistryKey>
      <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="urPDF" Type="string" Value="Software\urPDF\Capabilities" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="urPDF" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="PdfRegistration" />
    </Feature>
  </Package>
</Wix>
