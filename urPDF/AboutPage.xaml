<Page
    x:Class="urPDF.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:urPDF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource NavigationBackButtonNormalStyle}"/>
            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer x:Name="AboutScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <Border HorizontalAlignment="Stretch">
                <StackPanel Spacing="16"
                            Width="{Binding ViewportWidth, ElementName=AboutScrollViewer}"
                            MaxWidth="720"
                            HorizontalAlignment="Center">

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="Assets/StoreLogo.scale-400.png" 
                                   Width="88" Height="88" 
                                   Stretch="Uniform" 
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="urPDF" FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="Version 0.1.1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Minimalist, high-performance native PDF reader for Windows 11" 
                                           TextWrapping="Wrap" 
                                           Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <HyperlinkButton Grid.Column="0" 
                                         HorizontalAlignment="Stretch" 
                                         HorizontalContentAlignment="Stretch"
                                         NavigateUri="https://github.com/adasbl/urPDF/issues"
                                         Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xED15;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Send Feedback" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Report bugs or request features" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </HyperlinkButton>

                        <HyperlinkButton Grid.Column="1" 
                                         HorizontalAlignment="Stretch" 
                                         HorizontalContentAlignment="Stretch"
                                         NavigateUri="ms-windows-store://review/?ProductId=TODO"
                                         Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE735;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Review" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Leave a review in Microsoft Store" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </HyperlinkButton>
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">       
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Repository" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                </StackPanel>
                                <TextBlock Text="Visit project repository on GitHub" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" 
                             Content="Repository" 
                             NavigateUri="https://github.com/adasbl/urPDF" 
                             VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Developer" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                </StackPanel>
                                <TextBlock Text="Adam Błażejewski (adasbl)" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <HyperlinkButton Grid.Column="1" 
                                             Content="View on GitHub" 
                                             NavigateUri="https://github.com/adasbl" 
                                             VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="License" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="GNU Affero General Public License v3.0" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12" Padding="0,8,0,0">
                            <TextBlock Text="urPDF is free and open-source software released under the GNU AGPL v3. You are free to run, study, modify, and redistribute this software according to the terms of the license."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <HyperlinkButton Content="View Full License Agreement" 
                                             NavigateUri="https://raw.githubusercontent.com/adasbl/urPDF/main/LICENSE" 
                                             HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Privacy Policy" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Completely local and offline" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12" Padding="0,8,0,0">
                            <TextBlock Text="This application operates entirely offline. It does not collect, store, transmit, or share any personal data, telemetry, or documents. All PDF parsing and rendering happens solely within local device." 
                                       TextWrapping="Wrap" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <HyperlinkButton Content="Read Online Policy" 
                                             NavigateUri="https://raw.githubusercontent.com/adasbl/urPDF/main/PRIVACY.md" 
                                             HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEB51;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Third-Party Acknowledgments" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="MuPDF" FontWeight="Medium"/>
                                    <TextBlock Text="Lightweight PDF, XPS, and E-book rendering engine by Artifex Software, Inc." 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1" 
                                                 Content="Website" 
                                                 NavigateUri="https://mupdf.com/" 
                                                 VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>