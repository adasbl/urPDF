<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="urPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:urPDF"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="urPDF">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="SolidBackgroundLayer"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>

        <Grid x:Name="MainWindowUI" Grid.Row="0" Grid.RowSpan="2" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindInDocument_Invoked"/>
                <KeyboardAccelerator Key="F3" Invoked="FindNext_Invoked"/>
                <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="FindPrevious_Invoked"/>
                <KeyboardAccelerator Key="Escape" Invoked="ClearPdfSelection_Invoked"/>
                <KeyboardAccelerator Key="F11" Invoked="ToggleFullscreen_Invoked"/>
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="About urPDF"/>
                        <MenuFlyoutItem Text="Preferences"/>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Exit"/>
                    </MenuFlyout>
                </Border.ContextFlyout>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="UrPDF" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                    <TabView x:Name="MainTabView" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                             IsAddTabButtonVisible="False"
                             CanReorderTabs="True"
                             CanDragTabs="True"
                             TabWidthMode="Equal"
                             CanTearOutTabs="False"
                             AllowDropTabs="True"
                             AllowDrop="True"
                             DragOver="TabView_TabStripDragOver"
                             Drop="TabView_TabStripDrop"
                             TabDragStarting="TabView_TabDragStarting"
                             TabDragCompleted="TabView_TabDragCompleted"
                             TabStripDragOver="TabView_TabStripDragOver"
                             TabStripDrop="TabView_TabStripDrop"
                             TabDroppedOutside="TabView_TabDroppedOutside"
                             TabCloseRequested="TabView_TabCloseRequested" 
                             Loaded="TabView_Loaded"  
                             SelectionChanged="TabView_SelectionChanged">
                        <TabView.Resources>
                            <ResourceDictionary>
                                <Style TargetType="TabViewItem">
                                    <Setter Property="MinWidth" Value="{StaticResource TabViewItemMinWidth}"/>
                                    <Setter Property="MaxWidth" Value="{StaticResource TabViewItemMaxWidth}"/>
                                </Style>
                                
                                <Style TargetType="primitives:TabViewListView">
                                    <Setter Property="ItemContainerTransitions">
                                        <Setter.Value>
                                            <TransitionCollection>
                                                <ReorderThemeTransition/>
                                            </TransitionCollection>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SystemColorWindowColorBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                
                            </ResourceDictionary>
                        </TabView.Resources>

                        <TabView.TabStripFooter>
                            <SplitButton x:Name="NewTabSplitButton" Height="24" Margin="0,0,0,4" Padding="0"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                         Content="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                         AutomationProperties.Name="New tab"
                                         ToolTipService.ToolTip="New tab"
                                         Click="TabView_AddButtonClick">
                                <SplitButton.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Default">
                                                <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                                <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                                <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast">
                                                <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush"/>
                                                <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="SystemColorHighlightTextColorBrush"/>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                        <x:Double x:Key="SplitButtonPrimaryButtonSize">31</x:Double>
                                        <x:Double x:Key="SplitButtonSecondaryButtonSize">31</x:Double>
                                        <SolidColorBrush x:Key="SplitButtonBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent"/>
                                    </ResourceDictionary>
                                </SplitButton.Resources>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">

                                        <MenuFlyoutItem Text="Open PDF" Click="OpenPdfFileAsync">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="OpenFile"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open document in new window" Click="OpenPdfInNewWindowAsync">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A7;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </TabView.TabStripFooter>

                    </TabView>
                </Grid>
            </Border>

            <Border x:Name="MainContentBorder" Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,0"
                    CornerRadius="8,8,0,0">



                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="MainToolbar" Grid.Row="0" Margin="10,8,10,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">

                            <Button Click="OpenPdfFileAsync"
                                    ToolTipService.ToolTip="Open document">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;"/>
                                        <TextBlock Text="Open file" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button Click="PrintButton_Click"
                                    ToolTipService.ToolTip="Print document">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE749;"/>
                                        <TextBlock Text="Print" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button Click="SettingsButton_Click"
                                    ToolTipService.ToolTip="Open settings">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;"/>
                                        <TextBlock Text="Settings"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button Click="AboutButton_Click"
                                    ToolTipService.ToolTip="Go to about page">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE946;"/>
                                        <TextBlock Text="About"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Page: " VerticalAlignment="Center"/>
                                <NumberBox Value="{x:Bind DisplayPageNumber, Mode=OneWay}"
                                        Minimum="0"
                                        Maximum="{x:Bind DisplayPageCount, Mode=OneWay}"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="PageNumberBox_ValueChanged"
                                        SmallChange="1"
                                        Width="48"
                                        MinWidth="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center">
                                    <NumberBox.Resources>
                                        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                    </NumberBox.Resources>
                                </NumberBox>
                                <TextBlock VerticalAlignment="Center" Width="48" IsTextSelectionEnabled="False">
                                        <Run Text="of "/>
                                        <Run Text="{x:Bind DisplayPageCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Click="PreviousPageButton_Click"
                                    ToolTipService.ToolTip="Previous page">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE760;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Button Click="NextPageButton_Click"
                                    ToolTipService.ToolTip="Next page">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE761;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">

                            <Button x:Name="SearchButton"
                                    Click="SearchButton_Click"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Find in document"
                                    ToolTipService.ToolTip="Find in document (Ctrl+F)">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE721;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ZoomInButton" 
                                    Click="ZoomInButton_Click"
                                    ToolTipService.ToolTip="Zoom in">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A3;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ZoomOutButton" 
                                    Click="ZoomOutButton_Click"
                                    ToolTipService.ToolTip="Zoom out">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71F;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="RotateButton" 
                                    Click="RotateButton_Click"
                                    ToolTipService.ToolTip="Rotate pages">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7AD;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <SplitButton x:Name="FitPageSplitButton"
                                         IsEnabled="False"
                                         VerticalAlignment="Stretch"
                                         Padding="{StaticResource ButtonPadding}"
                                         Click="FitPageSplitButton_Click"
                                         AutomationProperties.Name="Fit vertically"
                                         ToolTipService.ToolTip="Fit vertically">
                                <SplitButton.Content>
                                    <Grid Width="20" Height="20">
                                        <PathIcon x:Name="FitVerticallyIcon"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="F1 M 1.5,1 H 18.5 V 2.6 H 1.5 Z M 1.5,17.4 H 18.5 V 19 H 1.5 Z M 10,3.6 L 14.2,7.8 L 13.07,8.93 L 10.8,6.66 V 13.34 L 13.07,11.07 L 14.2,12.2 L 10,16.4 L 5.8,12.2 L 6.93,11.07 L 9.2,13.34 V 6.66 L 6.93,8.93 L 5.8,7.8 Z"/>
                                        <PathIcon x:Name="FitHorizontallyIcon"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"
                                                  Data="F1 M 1,1.5 V 18.5 H 2.6 V 1.5 Z M 17.4,1.5 V 18.5 H 19 V 1.5 Z M 3.6,10 L 7.8,14.2 L 8.93,13.07 L 6.66,10.8 H 13.34 L 11.07,13.07 L 12.2,14.2 L 16.4,10 L 12.2,5.8 L 11.07,6.93 L 13.34,9.2 H 6.66 L 8.93,6.93 L 7.8,5.8 Z"/>
                                    </Grid>
                                </SplitButton.Content>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem x:Name="FitVerticallyMenuItem"
                                                        Text="Fit vertically"
                                                        Click="FitVerticallyMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon Data="F1 M 1.2,0.8 H 14.8 V 2.1 H 1.2 Z M 1.2,13.9 H 14.8 V 15.2 H 1.2 Z M 8,2.9 L 11.4,6.3 L 10.48,7.22 L 8.65,5.39 V 10.61 L 10.48,8.78 L 11.4,9.7 L 8,13.1 L 4.6,9.7 L 5.52,8.78 L 7.35,10.61 V 5.39 L 5.52,7.22 L 4.6,6.3 Z"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="FitHorizontallyMenuItem"
                                                        Text="Fit horizontally"
                                                        Click="FitHorizontallyMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon Data="F1 M 0.8,1.2 V 14.8 H 2.1 V 1.2 Z M 13.9,1.2 V 14.8 H 15.2 V 1.2 Z M 2.9,8 L 6.3,11.4 L 7.22,10.48 L 5.39,8.65 H 10.61 L 8.78,10.48 L 9.7,11.4 L 13.1,8 L 9.7,4.6 L 8.78,5.52 L 10.61,7.35 H 5.39 L 7.22,5.52 L 6.3,4.6 Z"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <Button x:Name="FullscreenButton"
                                    Click="FullscreenButton_Click"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Fullscreen"
                                    ToolTipService.ToolTip="Fullscreen (F11)">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9A6;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="BookViewButton"
                                    Click="BookViewButton_Click"
                                    ToolTipService.ToolTip="Change to book view">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE89A;"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DocumentViewHost" Grid.Row="1">
                        <ScrollViewer
                            x:Name="PdfScrollViewer"
                            KeyboardAcceleratorPlacementMode="Hidden"
                            ZoomMode="Enabled"
                            MinZoomFactor="0.5"
                            MaxZoomFactor="3.0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Tapped="PdfScrollViewer_Tapped"
                            ContextRequested="PdfScrollViewer_ContextRequested"
                            ViewChanged="PdfScrollViewer_ViewChanged">

                            <ScrollViewer.Resources>
                                <MenuFlyout x:Key="DocumentContextMenu" x:Name="DocumentContextMenu">
                                    <MenuFlyoutItem x:Name="CopyImageMenuItem" Text="Copy image" Click="CopyImageMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Copy"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SaveImageAsMenuItem" Text="Save image as..." Click="SaveImageAsMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Save"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ScrollViewer.Resources>

                            <ScrollViewer.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyPdfText_Invoked"/>
                            </ScrollViewer.KeyboardAccelerators>

                            <ItemsRepeater x:Name="PagesRepeater"
                                           HorizontalAlignment="Center"
                                           Margin="0,20"
                                           ElementPrepared="PagesRepeater_ElementPrepared"
                                           ElementClearing="PagesRepeater_ElementClearing"
                                           DoubleTapped="PageText_DoubleTapped"
                                           PointerMoved="PageText_PointerMoved"
                                           PointerReleased="PageText_PointerReleased"
                                           PointerCanceled="PageText_PointerCanceled"
                                           PointerCaptureLost="PageText_PointerCanceled">

                                <ItemsRepeater.Layout>
                                    <local:PdfPageLayout x:Name="PagesLayout" Spacing="10"/>
                                </ItemsRepeater.Layout>

                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Image Stretch="Uniform"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"/>
                                                <local:TextSelectionLayer Background="Transparent"
                                                                          ManipulationMode="System"
                                                                          PointerEntered="TextSelectionLayer_PointerEntered"
                                                                          PointerPressed="TextSelectionLayer_PointerPressed"
                                                                          PointerMoved="TextSelectionLayer_PointerMoved">
                                                    <local:TextSelectionLayer.Clip>
                                                        <RectangleGeometry Rect="0,0,0,0"/>
                                                    </local:TextSelectionLayer.Clip>
                                                    <Canvas IsHitTestVisible="False">
                                                        <Canvas.Resources>
                                                            <Style x:Key="PageImageSelectionBorderStyle" TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style x:Key="PageImageSelectionFillStyle" TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                                <Setter Property="Opacity" Value="0.22"/>
                                                            </Style>
                                                        </Canvas.Resources>
                                                    </Canvas>
                                                    <Canvas IsHitTestVisible="False">
                                                        <Canvas.Resources>
                                                            <ResourceDictionary>
                                                                <ResourceDictionary.ThemeDictionaries>
                                                                    <ResourceDictionary x:Key="Default">
                                                                        <SolidColorBrush x:Key="PageSearchMatchFillBrush" Color="#FFFFD43B"/>
                                                                        <SolidColorBrush x:Key="PageActiveSearchMatchFillBrush" Color="#FFFF922B"/>
                                                                        <SolidColorBrush x:Key="PageActiveSearchMatchStrokeBrush" Color="#FFFFA94D"/>
                                                                    </ResourceDictionary>
                                                                    <ResourceDictionary x:Key="Light">
                                                                        <SolidColorBrush x:Key="PageSearchMatchFillBrush" Color="#FFF7C600"/>
                                                                        <SolidColorBrush x:Key="PageActiveSearchMatchFillBrush" Color="#FFFF8C00"/>
                                                                        <SolidColorBrush x:Key="PageActiveSearchMatchStrokeBrush" Color="#FFD96600"/>
                                                                    </ResourceDictionary>
                                                                    <ResourceDictionary x:Key="HighContrast">
                                                                        <StaticResource x:Key="PageSearchMatchFillBrush" ResourceKey="SystemColorHighlightColorBrush"/>
                                                                        <StaticResource x:Key="PageActiveSearchMatchFillBrush" ResourceKey="SystemColorHighlightColorBrush"/>
                                                                        <StaticResource x:Key="PageActiveSearchMatchStrokeBrush" ResourceKey="SystemColorHighlightTextColorBrush"/>
                                                                    </ResourceDictionary>
                                                                </ResourceDictionary.ThemeDictionaries>
                                                                <Style x:Key="PageSearchMatchRectangleStyle" TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="{ThemeResource PageSearchMatchFillBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.38"/>
                                                                    <Setter Property="StrokeThickness" Value="0"/>
                                                                </Style>
                                                                <Style x:Key="PageActiveSearchMatchRectangleStyle" TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="{ThemeResource PageActiveSearchMatchFillBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.58"/>
                                                                    <Setter Property="Stroke" Value="{ThemeResource PageActiveSearchMatchStrokeBrush}"/>
                                                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                                                </Style>
                                                            </ResourceDictionary>
                                                        </Canvas.Resources>
                                                    </Canvas>
                                                    <Canvas IsHitTestVisible="False">
                                                        <Canvas.Resources>
                                                            <Style x:Key="PageSelectionRectangleStyle" TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Style>
                                                        </Canvas.Resources>
                                                    </Canvas>
                                                </local:TextSelectionLayer>
                                                <Canvas HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        IsHitTestVisible="True">
                                                    <Canvas.Clip>
                                                        <RectangleGeometry Rect="0,0,0,0"/>
                                                    </Canvas.Clip>
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>

                            </ItemsRepeater>

                        </ScrollViewer>

                        <Border x:Name="SearchBar"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,24,0"
                                Padding="8,6"
                                CornerRadius="8"
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Canvas.ZIndex="10">
                            <Grid ColumnSpacing="4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchTextBox"
                                         Grid.Column="0"
                                         PlaceholderText="Find in document"
                                         AutomationProperties.Name="Find in document"
                                         TextChanged="SearchTextBox_TextChanged"
                                         KeyDown="SearchTextBox_KeyDown"/>
                                <Grid Grid.Column="1" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing x:Name="SearchProgressRing"
                                                  Grid.Column="0"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,6,0"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchStatusText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="False"/>
                                </Grid>
                                <Button x:Name="SearchPreviousButton"
                                        Grid.Column="2"
                                        Click="SearchPreviousButton_Click"
                                        IsEnabled="False"
                                        Padding="6"
                                        AutomationProperties.Name="Previous match"
                                        ToolTipService.ToolTip="Previous match (Shift+Enter)">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                </Button>
                                <Button x:Name="SearchNextButton"
                                        Grid.Column="3"
                                        Click="SearchNextButton_Click"
                                        IsEnabled="False"
                                        Padding="6"
                                        AutomationProperties.Name="Next match"
                                        ToolTipService.ToolTip="Next match (Enter)">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                </Button>
                                <Button x:Name="SearchCloseButton"
                                        Grid.Column="4"
                                        Click="SearchCloseButton_Click"
                                        Padding="6"
                                        AutomationProperties.Name="Close search"
                                        ToolTipService.ToolTip="Close (Esc)">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Button x:Name="FullscreenExitButton"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,16,0,0"
                                Width="40"
                                Height="40"
                                Padding="0"
                                CornerRadius="20"
                                BorderThickness="1"
                                Canvas.ZIndex="20"
                                AutomationProperties.Name="Exit fullscreen"
                                ToolTipService.ToolTip="Exit fullscreen (Esc)"
                                Click="FullscreenExitButton_Click"
                                PointerEntered="FullscreenExitButton_PointerEntered"
                                PointerExited="FullscreenExitButton_PointerExited">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SolidBackgroundFillColorTertiaryBrush"/>
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SolidBackgroundFillColorQuinaryBrush"/>
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush"/>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SolidBackgroundFillColorBaseBrush"/>
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SolidBackgroundFillColorTertiaryBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush"/>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SystemColorWindowColorBrush"/>
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush"/>
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SystemColorWindowTextColorBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SystemColorWindowTextColorBrush"/>
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SystemColorWindowTextColorBrush"/>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                        </Button>

                        <Border x:Name="EmptyTabDropZone"
                            AllowDrop="True"
                            DragOver="EmptyTab_DragOver"
                            DragLeave="EmptyTab_DragLeave"
                            Drop="EmptyTab_Drop"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="24"
                            Padding="32"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Spacing="12">
                                <Image Source="Assets/StoreLogo.scale-400.png"
                                    Width="96"
                                    Height="96"
                                    HorizontalAlignment="Center"
                                    Stretch="Uniform"/>
                                <TextBlock Text="Welcome to urPDF"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"/>
                                <Button x:Name="EmptyTabButton"
                                    Click="OpenPdfFileAsync"
                                    Width="180"
                                    MinHeight="48"
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="24,12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;"/>
                                        <TextBlock Text="Open PDF"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="or drag and drop your PDF anywhere in this area."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyTabDropHint"
                                    Text="Release to open PDF"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    FontWeight="SemiBold"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Canvas.ZIndex="100"/>

        <Grid x:Name="SettingsOverlay"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            Background="#80000000"
            Canvas.ZIndex="200">
            <Border Width="800"
                Height="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                CornerRadius="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Frame x:Name="SettingsFrame"
                         Grid.Row="0"/>
                    <Button Grid.Row="1"
                        Content="Close"
                        HorizontalAlignment="Right"
                        Click="CloseSettings_Click"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
