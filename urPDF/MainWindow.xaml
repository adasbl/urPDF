<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="urPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="urPDF">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="About urPDF"/>
                    <MenuFlyoutItem Text="Preferences"/>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit"/>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="UrPDF" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                <TabView x:Name="MainTabView" Grid.Column="1" HorizontalAlignment="Stretch" 
                         AddTabButtonClick="TabView_AddButtonClick" 
                         TabCloseRequested="TabView_TabCloseRequested" 
                         Loaded="TabView_Loaded"  
                         SelectionChanged="TabView_SelectionChanged">
                    <TabView.Resources>
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" 
                        ResourceKey="LayerFillColorDefaultBrush" />
                        <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOverSelected" 
                        ResourceKey="LayerFillColorDefaultBrush" />
                        <StaticResource x:Key="TabViewItemHeaderBackgroundPressedSelected" 
                        ResourceKey="LayerFillColorDefaultBrush" />
                    </TabView.Resources>
                </TabView>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,0"
                CornerRadius="8,8,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8,10,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                        
                        <Button Click="OpenPdfFileAsync">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;"/>
                                    <TextBlock Text="Open file" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button Click="PrintButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE749;"/>
                                    <TextBlock Text="Print" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        
                        <Button Click="SettingsButton_Click" >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;"/>
                                    <TextBlock Text="Settings"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        
                        <Button Click="AboutButton_Click" >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;"/>
                                    <TextBlock Text="About"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Page: " VerticalAlignment="Center"/>
                            <NumberBox Value="{x:Bind DisplayPageNumber, Mode=OneWay}"
                                Minimum="0"
                                Maximum="100"
                                SpinButtonPlacementMode="Hidden"
                                ValueChanged="PageNumberBox_ValueChanged"
                                SmallChange="1"
                                Width="48"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Width="48" IsTextSelectionEnabled="False">
                                <Run Text="of "/>
                                <Run Text="{x:Bind DisplayPageCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Click="PreviousPageButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE760;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Click="NextPageButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE761;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                        <Button>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A3;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71F;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Click="RotateButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7AD;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9A6;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE89A;"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1"
                              x:Name="PdfScrollViewer" 
                              ZoomMode="Enabled" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              ViewChanged="PdfScrollViewer_ViewChanged">
                    <StackPanel x:Name="PagesContainer" HorizontalAlignment="Center" Spacing="15" Margin="20"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Frame x:Name="RootFrame" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Canvas.ZIndex="100"/>
    </Grid>
</Window>