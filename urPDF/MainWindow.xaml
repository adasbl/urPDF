<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="urPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="urPDF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Text="UrPDF" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
        </Border>
        
        <Grid Grid.Row="1">
            <ScrollViewer ZoomMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PdfImageDisplay" Stretch="Uniform" Margin="20"/>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30">
                <Button Content="Open PDF" Click="OpenButton_Click" Margin="0,0,10,0"/>
                <Button Content="Print" Margin="0,0,10,0"/>
                <Button Content="Settings" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
