<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="urPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="urPDF">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="About urPDF"/>
                    <MenuFlyoutItem Text="Preferences"/>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit"/>
                </MenuFlyout>
            </Border.ContextFlyout>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="UrPDF" VerticalAlignment="Center" Margin="16,8,8,0" FontWeight="SemiBold"/>
                <TabView x:Name="MainTabView"  Grid.Column="1" HorizontalAlignment="Stretch" 
                         AddTabButtonClick = "TabView_AddButtonClick" 
                         TabCloseRequested = "TabView_TabCloseRequested" 
                         Loaded = "TabView_Loaded"  
                         SelectionChanged = "TabView_SelectionChanged"/>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button Click="OpenPdfFileAsync" Margin="10,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;"/>
                            <TextBlock Text="Open file" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE749;"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A3;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71F;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7AD;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9A6;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE89A;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE760;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Margin="0,0,10,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE761;"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <ToggleSwitch
                    OffContent="Light" OnContent="Dark" 
                    Toggled="ToggleSwitch_Toggled"/>        
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="PdfScrollViewer" 
              ZoomMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
              ViewChanged="PdfScrollViewer_ViewChanged">
                <StackPanel x:Name="PagesContainer" HorizontalAlignment="Center" Spacing="15" Margin="20"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
