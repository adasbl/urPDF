<Page
    x:Class="urPDF.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:urPDF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource NavigationBackButtonNormalStyle}"/>
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
                        <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        <ComboBox
                            x:Name="ThemeComboBox"
                            Width="160"
                            SelectionChanged="ThemeSelection_SelectionChanged">  
                            <ComboBoxItem Content="Default (System)" Tag="Default"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
                        <TextBlock Text="Transparency Effect" VerticalAlignment="Center"/>
                        <ComboBox
                            x:Name="TransparencyComboBox"
                            Width="160"
                            SelectionChanged="TransparencySelection_SelectionChanged">
                            <ComboBoxItem Content="None" Tag="None"/>
                            <ComboBoxItem Content="Mica (recommended)" Tag="Mica"/>
                            <ComboBoxItem Content="Mica Alt" Tag="MicaAlt"/>
                        </ComboBox>
                    </StackPanel>
                    
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Default behavior" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <ComboBox
                        x:Name="WindowStartupModeComboBox"
                        Header="Window state at startup"
                        Width="280"
                        Margin="8,0,0,0"
                        SelectionChanged="WindowStartupModeSelection_SelectionChanged">
                        <ComboBoxItem Content="Remember last state" Tag="RememberLastState"/>
                        <ComboBoxItem Content="Always maximized" Tag="Maximized"/>
                        <ComboBoxItem Content="Always in a normal window" Tag="Normal"/>
                    </ComboBox>

                    <ToggleSwitch
                        x:Name="OpenFilesInExistingWindowToggle"
                        Header="Open files from File Explorer in an existing window"
                        Margin="8,0,0,0"
                        Toggled="OpenFilesInExistingWindowToggle_Toggled"/>
                    
                </StackPanel>

                

                <StackPanel Spacing="12">
                    <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="urPDF - Version 0.2.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="Button" Click="ClickHandler" Content="Check for updates" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
